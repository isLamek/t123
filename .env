# ──────────────────────────────────────────────────────────────────────────
#  Omugongo secrets.  Nothing here is committed to git (see .gitignore).
#  The app runs even with everything blank — it just falls back to keyword
#  matching and skips alerts.
# ──────────────────────────────────────────────────────────────────────────

# ── AI brain ────────────────────────────────────────────────────────────────
# Default provider is Gemini (free tier). Get a free key:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6IlhJ9J-AvS2j6A7CyZizBjp40DmXJMLY4fJutbX4vwRw

# Optional — flip PROVIDER to "anthropic" in the Settings tab to use Claude.
# Get a key (paid, cheap):  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Alerts: Telegram (recommended) ───────────────────────────────────────────
# 1. In Telegram, message @BotFather -> /newbot -> copy the token below.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alerts: WhatsApp via CallMeBot (free, personal) ──────────────────────────
# Setup (one time): https://www.callmebot.com/blog/free-api-whatsapp-messages/
#   Send "I allow callmebot to send me messages" to +34 644 51 95 23 on WhatsApp,
#   it replies with your personal apikey.
CALLMEBOT_PHONE=+264
CALLMEBOT_APIKEY=

# ── Alerts: Email digest (Gmail) ─────────────────────────────────────────────
# Use a Gmail "App Password" (not your normal password):
#   https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=lamekshaliindongo@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_TO=lamekshaliindongo@gmail.com

# ── Optional: paid search API for more reliable web search ───────────────────
# Leave blank to use the free DuckDuckGo scraper. Brave gives 2,000 free/month:
#   https://brave.com/search/api/
BRAVE_API_KEY=
